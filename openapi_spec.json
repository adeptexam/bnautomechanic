    "/users/me": {
      "delete": {
        "description": "Allows a customer to permanently delete their own account, saved vehicles, and associated data. Revokes active tokens and closes any sessions.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "password": {
                    "description": "Current account password for security confirmation (optional if session is trusted)",
                    "type": "string"
                  },
                  "reason": {
                    "description": "Optional departure feedback for workshop management",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "Account and personal data successfully deleted"
          },
          "401": {
            "description": "Unauthorized or incorrect password"
          },
          "403": {
            "description": "Forbidden for staff administrators"
          },
          "409": {
            "description": "Active vehicle service in progress or outstanding balance on invoice"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Delete authenticated customer account and personal data (Self-service)",
        "tags": [
          "Customer"
        ]
      },

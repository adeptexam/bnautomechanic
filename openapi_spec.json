  "info": {
    "contact": {
      "email": "support@bnautomechanic.net",
      "name": "BN Auto Mechanic Support",
      "url": "https://bnautomechanic.net"
    },
    "description": "Official enterprise REST API for **BN Auto Mechanic (BN Automobiles)**. Powers the Web Portal (React / TypeScript), iOS Application (Swift / SwiftUI), and Android Application (Kotlin / Jetpack Compose).\n\n### Key Architectural Features:\n- **Stateless Bearer JWT Authentication** (`HS256`)\n- **Dual-Prefix Support**: Fully accessible via `/api/v2` and `/api/v1`\n- **Standardized Envelope Responses**: `{ \"success\": true, \"data\": ... }`\n- **Mobile-First Design**: Null-safe schemas, standard ISO 8601 UTC timestamps\n- **Push Notifications**: Device token registration for APNs (iOS) & FCM (Android)",
    "license": {
      "name": "Proprietary",
      "url": "https://bnautomechanic.net/terms"
    },
    "title": "BN Auto Mechanic REST API",
    "version": "2.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/auth/login": {
      "post": {
        "description": "Validates email and password, returning short-lived access token and long-lived refresh token.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AuthResponse"
                    },
                    "success": {
                      "example": true,
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Login successful"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid credentials"
          }
        },
        "summary": "Authenticate user & issue JWT tokens",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "responses": {
          "200": {
            "description": "Current user profile data"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get authenticated user profile",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "refresh_token": {
                    "type": "string"
                  }
                },
                "required": [
                  "refresh_token"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "New access and refresh tokens returned"
          },
          "401": {
            "description": "Expired or invalid refresh token"
          }
        },
        "summary": "Rotate tokens using refresh token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Account created successfully"
          },
          "400": {
            "description": "Validation error or email already in use"
          }
        },
        "summary": "Create customer account",
        "tags": [
          "Auth"
        ]
      }
    },
